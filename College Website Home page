  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <h1>Empowering the Next Generation of Thinkers</h1>
      <p>Discover world-class research facilities, global faculty, and over 120 majors designed for the future.</p>
      <div class="hero-buttons">
        <a href="#academics" class="btn-primary">Explore Programs</a>
        <a href="#campus" class="btn-secondary">Virtual Tour</a>
      </div>
    </div>
  </section>

  <!-- Quick Statistics -->
  <section class="stats-bar">
    <div class="container">
      <div class="stats-grid">
        <div>
          <span class="stat-number">14:1</span>
          <span class="stat-label">Student to Faculty Ratio</span>
        </div>
        <div>
          <span class="stat-number">94%</span>
          <span class="stat-label">Post-Grad Employment Rate</span>
        </div>
        <div>
          <span class="stat-number">120+</span>
          <span class="stat-label">Undergraduate Degrees</span>
        </div>
        <div>
          <span class="stat-number">50+</span>
          <span class="stat-label">Countries Represented</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Academic Programs -->
  <section class="academics" id="academics">
    <div class="container">
      <div class="section-header">
        <h2>Academic Divisions</h2>
        <p>Rigorous academics paired with hands-on experiential learning.</p>
      </div>
      <div class="card-grid">
        <div class="card">
          <h3>School of Engineering & Computing</h3>
          <p>Lead the technological frontier in software engineering, robotics, data science, and renewable energy systems.</p>
          <a href="#">Learn more &rarr;</a>
        </div>
        <div class="card">
          <h3>School of Business & Economics</h3>
          <p>Gain global perspectives in finance, entrepreneurship, marketing, and sustainable management.</p>
          <a href="#">Learn more &rarr;</a>
        </div>
        <div class="card">
          <h3>College of Health Sciences</h3>
          <p>Train in state-of-the-art simulation labs to excel in nursing, pre-med, biomedical sciences, and public health.</p>
          <a href="#">Learn more &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Banner -->
  <section class="cta-banner" id="admissions">
    <div class="container">
      <h2>Applications for Fall 2026 Are Open</h2>
      <p style="margin-bottom: 2rem;">Take the first step toward your degree. Early action deadline is November 15.</p>
      <a href="#apply" class="btn-primary" style="display: inline-block;">Start Your Application</a>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>Apex University</h4>
          <p>1200 Academic Way<br />Metro City, MC 98101<br />info@apex.edu</p>
        </div>
        <div class="footer-col">
          <h4>Academics</h4>
          <ul>
            <li><a href="#">Undergraduate</a></li>
            <li><a href="#">Graduate & Professional</a></li>
            <li><a href="#">Online Programs</a></li>
            <li><a href="#">Academic Calendar</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Admissions</h4>
          <ul>
            <li><a href="#">How to Apply</a></li>
            <li><a href="#">Tuition & Aid</a></li>
